       </font>
      </property>
      <property name="styleSheet">
       <string notr="true">QRadioButton {
    color: #DCD7BA;
    spacing: 8px;
    font-size: 15px;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 9px; /* Половина от (width + 2*border) = (14 + 4)/2 = 9px для ровного круга */
    border: 2px solid #7E9CD8;
    background-color: #363646;
}

QRadioButton::indicator:hover {
    border-color: #9CABCA;
    background-color: #363646;
}

/* Состояние &quot;Выбрано&quot; — маркер цвета #DCD7BA */
QRadioButton::indicator:checked {
    border: 2px solid #7E9CD8;
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.4,
        fx: 0.5, fy: 0.5,
        stop: 0.0 #DCD7BA,
        stop: 0.6 #DCD7BA,
        stop: 0.7 #1F1F28,
        stop: 1.0 #1F1F28
    );
}
</string>
      </property>
      <property name="text">
       <string>По длительности</string>
      </property>
      <property name="checkable">
       <bool>true</bool>
      </property>
      <property name="checked">
       <bool>true</bool>
      </property>
     </widget>
